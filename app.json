{
  "expo": {
    "name": "NutriKitchen",
    "slug": "nutrikitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutrikitchen",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.nutrikitchen.app",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "require-corp",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
